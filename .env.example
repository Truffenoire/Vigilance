# ==========================================
# CONFIGURATION VIGILANCE (ENV EXEMPLE)
# ==========================================

# Clé secrète Django (générée aléatoirement, obligatoire en production)
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-32-chars-min

# Mode Debug (True en dev, False en production)
DEBUG=True

# Hôtes autorisés (séparés par une virgule)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données :
# Laissez vide pour utiliser SQLite en local sans configuration,
# ou spécifiez une URL PostgreSQL complète (ex: postgres://user:password@localhost:5432/vigilance)
DATABASE_URL=

# Limite de taille des fichiers envoyés (en Mo)
MAX_UPLOAD_SIZE_MB=10

# Backend de stockage définitif :
# 'local_archive' pour tester en local sans identifiants Google,
# 'google_drive' pour archiver sur Google Drive via l'API officielle
STORAGE_BACKEND=local_archive

# Dossiers locaux de traitement
TEMP_UPLOAD_DIR=storage/temp
LOCAL_ARCHIVE_DIR=storage/archive

# Configuration Google Drive (requis si STORAGE_BACKEND=google_drive)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Chemin vers l'exécutable Tesseract OCR (optionnel si dans le PATH)
# Exemple sur macOS : /opt/homebrew/bin/tesseract
TESSERACT_CMD=
